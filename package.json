{
  "name": "@aihq/core",
  "version": "0.0.0-dev.1",
  "description": "Headless environment repair and explicit policy execution",
  "type": "module",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./contracts": {
      "types": "./dist/core/contracts.d.ts",
      "import": "./dist/core/contracts.js"
    },
    "./harness": {
      "types": "./dist/harness/public.d.mts",
      "import": "./dist/harness/public.mjs"
    },
    "./harness/runtime": {
      "types": "./dist/harness/runtime-public.d.mts",
      "import": "./dist/harness/runtime-public.mjs"
    }
  },
  "bin": {
    "aih": "dist/core/cli.js",
    "aih-linux-facility": "dist/harness/native/linux/facility"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "docs/native-windows-verification.md",
    "docs/native-linux-verification.md",
    "docs/native-persistence-diagnostics.md",
    "docs/macos-session-development.md",
    "docs/reporting/CONTRACT.md",
    "docs/reporting/FIELDS.md",
    "docs/reporting/REPRODUCE.md",
    "examples/reporting"
  ],
  "bundleDependencies": [
    "@sigstore/bundle",
    "@sigstore/protobuf-specs",
    "@sigstore/verify",
    "pkijs",
    "asn1js",
    "@anthropic-ai/sandbox-runtime"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack:distribution": "node scripts/pack-distribution.mjs --build",
    "typecheck": "tsc --noEmit",
    "verify:public-consumer": "node scripts/verify-public-consumer.mjs",
    "test": "node scripts/run-ci-tests.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.78",
    "@sigstore/bundle": "5.0.0",
    "@sigstore/protobuf-specs": "0.5.0",
    "@sigstore/verify": "4.1.2",
    "ajv": "8.20.0",
    "asn1js": "3.0.10",
    "jsonc-parser": "3.3.1",
    "pkijs": "3.4.1"
  },
  "peerDependencies": {
    "@aihq/scan": ">=0.0.0-0 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@aihq/scan": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "tar": "7.5.22",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0"
}
