{
  "name": "@aihq/core",
  "version": "1.0.0-dev.0",
  "description": "Headless environment repair and explicit policy execution",
  "type": "module",
  "engines": { "node": ">=24.6.0 <25" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./contracts": { "types": "./dist/contracts.d.ts", "import": "./dist/contracts.js" },
    "./schemas/execution-policy/1.0.0.json": "./dist/schemas/execution-policy/1.0.0.json",
    "./schemas/recipe/1.0.0.json": "./dist/schemas/recipe/1.0.0.json",
    "./schemas/prepared-work/1.0.0.json": "./dist/schemas/prepared-work/1.0.0.json",
    "./schemas/run-result/1.0.0.json": "./dist/schemas/run-result/1.0.0.json"
  },
  "bin": { "aih": "./dist/cli.js" },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": { "@aihq/harness": ">=2.0.0-dev.0 <3", "ajv": "8.20.0", "jsonc-parser": "3.3.1" },
  "devDependencies": { "@types/node": "24.10.1", "typescript": "7.0.2", "esbuild": "0.28.2" },
  "license": "Apache-2.0"
}
