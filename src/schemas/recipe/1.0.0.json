{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:recipe:1.0.0",
  "title": "Core recipe (initial development slice)",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "id", "description", "inputs", "materials", "targets", "prerequisites", "operations", "checks"],
  "properties": {
    "schema": { "const": "urn:aihq:core:recipe:1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "description": { "type": "string", "maxLength": 4096 },
    "inputs": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/input" } },
    "materials": { "type": "array", "maxItems": 0 },
    "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["project", "user"] } },
    "prerequisites": { "type": "array", "maxItems": 0 },
    "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "checks": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "slot": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["literal"], "properties": { "literal": {} } },
      { "type": "object", "additionalProperties": false, "required": ["input"], "properties": { "input": { "$ref": "#/$defs/id" } } }
    ]},
    "input": {
      "type": "object", "additionalProperties": false, "required": ["type", "required"],
      "properties": {
        "type": { "enum": ["string", "boolean", "integer", "number"] }, "required": { "type": "boolean" },
        "default": {}, "enum": { "type": "array", "minItems": 1, "uniqueItems": true },
        "description": { "type": "string", "maxLength": 4096 }, "sensitive": { "type": "boolean" },
        "minLength": { "type": "integer", "minimum": 0 }, "maxLength": { "type": "integer", "minimum": 0 },
        "minimum": { "type": "number" }, "maximum": { "type": "number" }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["root", "segments"],
      "properties": {
        "root": { "enum": ["project", "userHome", "userState"] },
        "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slot" } }
      }
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "purpose", "kind", "scope", "target", "content", "requires", "checks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "purpose": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "kind": { "const": "file.write" }, "scope": { "enum": ["project", "user"] },
        "target": { "$ref": "#/$defs/target" }, "content": { "$ref": "#/$defs/slot" },
        "requires": { "$ref": "#/$defs/ids" }, "checks": { "type": "array", "maxItems": 0 }
      }
    }
  }
}
