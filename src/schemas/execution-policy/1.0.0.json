{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:execution-policy:1.0.0",
  "title": "Core execution policy (initial development slice)",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "mode", "selections"],
  "properties": {
    "schema": { "const": "urn:aihq:core:execution-policy:1.0.0" }, "mode": { "const": "vibe" },
    "metadata": { "type": "object" },
    "selections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "managementId", "scope", "configuration", "requires", "recipe"],
        "properties": {
          "id": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id" },
          "managementId": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id" },
          "scope": { "enum": ["project", "user"] }, "configuration": { "type": "object" },
          "requires": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/ids" },
          "recipe": { "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["inline"], "properties": { "inline": { "$ref": "urn:aihq:core:recipe:1.0.0" } } },
            { "type": "object", "additionalProperties": false, "required": ["reference"], "properties": { "reference": {
              "type": "object", "additionalProperties": false,
              "required": ["source", "path", "sha256", "byteLength", "materials"],
              "properties": {
                "source": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/source" },
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/sha256" },
                "byteLength": { "type": "integer", "minimum": 1, "maximum": 1000000 },
                "materials": { "type": "array", "items": { "type": "object", "additionalProperties": false,
                  "required": ["id", "path", "sha256", "byteLength"], "properties": {
                    "id": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id" }, "path": { "type": "string", "minLength": 1 },
                    "sha256": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/sha256" },
                    "byteLength": { "type": "integer", "minimum": 0, "maximum": 16777216 }
                  } } }
              }
            } } }
          ] }
        }
      }
    }
  }
}
