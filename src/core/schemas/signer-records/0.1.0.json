{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:signer-records:0.1.0",
  "title": "Default allowed Scan signers",
  "description": "The Scan signers Core trusts by default (contract 6, 13, C35), in Scan's signer shape: an OIDC issuer and exact certificate subject, plus optional Fulcio certificate extensions that must also match. `identity` is only a label; trust comes from the authenticated issuer and subject. An organization's `scanSigners` replaces or extends this list; it never blocks anything.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "signers"],
  "properties": {
    "schema": { "const": "urn:aihq:core:signer-records:0.1.0" },
    "signers": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/signer" } }
  },
  "$defs": {
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "issuer", "subject"],
      "properties": {
        "identity": { "type": "string", "minLength": 1, "maxLength": 256 },
        "issuer": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "extensions": { "type": "object", "propertyNames": { "pattern": "^[0-9]+([.][0-9]+)+$" },
          "additionalProperties": { "type": "string", "maxLength": 2048 } }
      }
    }
  }
}
