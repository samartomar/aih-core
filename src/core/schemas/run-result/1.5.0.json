{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:run-result:1.5.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "scanId": {
            "type": "string",
            "pattern": "^scan:sha256:[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "skipped",
              "authenticated",
              "unverifiable"
            ]
          },
          "reason": {
            "enum": [
              "not-supplied",
              "not-requested",
              "unavailable",
              "unsupported-artifact",
              "malformed",
              "id-mismatch",
              "byte-mismatch",
              "unsigned",
              "unknown-producer",
              "untrusted-key",
              "invalid-signature",
              "resource-limit",
              "not-covered"
            ]
          },
          "producerIdentity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "keyId": {
            "type": "string",
            "pattern": "^ed25519:[a-f0-9]{64}$"
          },
          "reportRead": {
            "enum": [
              "supported",
              "unsupported",
              "not-requested"
            ]
          }
        }
      }
    },
    "schema": {
      "const": "urn:aihq:core:run-result:1.5.0"
    },
    "runId": {
      "type": "string"
    },
    "useCase": {
      "enum": [
        "policy"
      ]
    },
    "completion": {
      "enum": [
        "complete",
        "incomplete",
        "cancelled",
        "rejected"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "organization": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "provider": {
                      "const": "github"
                    },
                    "repository": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "owner": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "owner",
                        "name"
                      ]
                    },
                    "path": {
                      "type": "string"
                    },
                    "revision": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "enum": [
                            "commit",
                            "branch",
                            "tag"
                          ]
                        },
                        "value": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "value"
                      ]
                    }
                  },
                  "required": [
                    "provider",
                    "repository",
                    "path",
                    "revision"
                  ]
                },
                "resolvedCommit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "blobId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "contentDigest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "policyId": {
                  "type": "string"
                },
                "helper": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "const": "github-policy-reader"
                    },
                    "package": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "version"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "package"
                  ]
                }
              },
              "required": [
                "source",
                "resolvedCommit",
                "blobId",
                "contentDigest",
                "policyId",
                "helper"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "contentDigest",
                "policyId",
                "helper"
              ],
              "properties": {
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "provider",
                    "fileName"
                  ],
                  "properties": {
                    "provider": {
                      "const": "local"
                    },
                    "fileName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  }
                },
                "contentDigest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "policyId": {
                  "type": "string"
                },
                "helper": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "package"
                  ],
                  "properties": {
                    "id": {
                      "const": "local-policy-reader"
                    },
                    "package": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "version"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "helperSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidateKind": {
          "enum": [
            "system-ca",
            "extra-ca"
          ]
        },
        "certificates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ]
        }
      },
      "required": [
        "package"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "candidateKind": {
                "const": "system-ca"
              }
            },
            "required": [
              "candidateKind"
            ]
          },
          "then": {
            "properties": {
              "certificates": {
                "type": "array",
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "certificates": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "properties": {
            "policySha256": {}
          },
          "required": [
            "policySha256"
          ]
        },
        {
          "properties": {
            "sourceSha256": {},
            "helperSha256": {},
            "certificates": {}
          },
          "required": [
            "sourceSha256",
            "helperSha256",
            "certificates"
          ]
        }
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "interactive",
            "automation"
          ]
        },
        "allowPartial": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "boolean"
            },
            "origin": {
              "enum": [
                "default",
                "explicit"
              ]
            }
          },
          "required": [
            "value",
            "origin"
          ]
        },
        "reviewDigest": {
          "type": "string",
          "minLength": 1,
          "description": "The review digest this run applied; present for prepared work 1.6.0 reviews."
        }
      },
      "required": [
        "origin",
        "allowPartial"
      ]
    },
    "effectiveOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "enum": [
                "on",
                "off"
              ]
            },
            "origin": {
              "enum": [
                "default",
                "explicit"
              ]
            }
          },
          "required": [
            "value",
            "origin"
          ]
        }
      },
      "required": [
        "logging"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "application": {
            "enum": [
              "not-attempted",
              "already-satisfied",
              "applied",
              "failed"
            ]
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "unverified",
                  "passed",
                  "failed",
                  "unavailable",
                  "skipped"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "reason"
            ]
          },
          "reason": {
            "type": "string"
          },
          "effectsUncertain": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "application",
          "verification"
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operationId",
          "status",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "operationId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unavailable",
              "skipped"
            ]
          },
          "reason": {
            "type": "string"
          },
          "effectsUncertain": {
            "type": "boolean"
          },
          "terminationUnconfirmed": {
            "type": "boolean"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "encountered": {
            "type": "string"
          },
          "supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "block": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "assessedBlocks": {
            "type": "integer",
            "minimum": 0
          },
          "assessmentLimit": {
            "type": "string"
          },
          "guidance": {
            "type": "string"
          },
          "changed": {
            "enum": [
              "policy",
              "index-status",
              "scan-state",
              "binding",
              "target-file"
            ]
          }
        },
        "required": [
          "code",
          "reason",
          "message"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "changed": {}
              },
              "required": [
                "changed"
              ]
            },
            "then": {
              "properties": {
                "code": {
                  "const": "REVIEW_STALE"
                },
                "reason": {
                  "const": "binding-changed"
                }
              }
            }
          }
        ]
      }
    },
    "record": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "written"
            },
            "reference": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "reference"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "disabled"
            },
            "reason": {
              "const": "logging-off"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "failed"
            },
            "reason": {
              "enum": [
                "record-limit",
                "record-write"
              ]
            },
            "diagnosticId": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason",
            "diagnosticId"
          ]
        }
      ]
    },
    "recovery": {
      "type": "string"
    },
    "followUp": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "members": {
      "description": "Every member a reviewed file operation touched, checked directly on disk after Apply. intent comes from the reviewed plan; outcome is what the run did; check is what Core found afterwards. Confirmed on disk requires completion complete and every write member written and present-matching. Removed requires every remove member claim-removed and absent, or restored and present-matching.",
      "type": "array",
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "selectionId",
          "managementId",
          "scope",
          "kind",
          "path",
          "intent",
          "outcome",
          "check"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "selectionId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "managementId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "kind": {
            "enum": [
              "file",
              "text-block",
              "entry-block",
              "entry-pointer",
              "config-entry",
              "config-member",
              "hook-group-member"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "pointer": {
            "type": "string",
            "maxLength": 4096
          },
          "blockId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "groupId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "intent": {
            "enum": [
              "write",
              "remove",
              "keep"
            ]
          },
          "outcome": {
            "enum": [
              "written",
              "claim-removed",
              "restored",
              "kept"
            ]
          },
          "check": {
            "enum": [
              "present-matching",
              "present-different",
              "absent",
              "unchecked"
            ]
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "runId",
    "useCase",
    "completion",
    "effectiveOptions",
    "operations",
    "checks",
    "diagnostics",
    "record",
    "followUp"
  ],
  "title": "Core policy run result naming the changed review binding and checking each touched member"
}
