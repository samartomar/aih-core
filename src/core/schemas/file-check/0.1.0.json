{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:file-check:0.1.0",
  "title": "File check",
  "description": "The read-only comparison of what a plan or change request would write with what is on disk (contract 10, 14.1). observation is complete only when every planned file was compared and nothing was left unchecked; fileState is match only then, changed when any compared file differs or is absent, unverified otherwise. Nothing was written, recorded, downloaded or run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "request", "package", "observation", "fileState", "authority", "targets", "checks", "notChecked",
    "coverage", "diagnostics", "limits"],
  "properties": {
    "schema": { "const": "urn:aihq:core:file-check:0.1.0" },
    "status": { "const": "ok" },
    "request": { "enum": ["plan", "change"] },
    "package": { "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } } },
    "observation": { "enum": ["complete", "incomplete", "cancelled"] },
    "fileState": { "enum": ["match", "changed", "unverified"] },
    "authority": { "const": "not-evaluated" },
    "targets": { "type": "array", "maxItems": 4096, "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "steps", "managementIds", "target", "outcome", "reason"],
      "properties": {
        "id": { "type": "string" },
        "steps": { "type": "array", "items": { "oneOf": [{ "type": "integer" }, { "type": "string" }] } },
        "managementIds": { "type": "array", "items": { "type": "string" } },
        "target": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["root", "path"],
          "properties": { "root": { "enum": ["project", "user"] }, "path": { "type": "string" } } }] },
        "outcome": { "enum": ["match", "changed", "absent", "unavailable"] },
        "reason": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" } } } },
    "checks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "outcome", "reason"],
      "properties": { "id": { "type": "string" }, "outcome": { "enum": ["passed", "failed", "unavailable", "not-checked"] }, "reason": { "type": "string" } } } },
    "notChecked": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "reason"],
      "properties": { "kind": { "type": "string" }, "id": { "type": "string" }, "reason": { "type": "string" } } } },
    "coverage": { "type": "object", "additionalProperties": false,
      "required": ["comparedTargets", "unavailableTargets", "comparedChecks", "unavailableChecks", "notChecked"],
      "properties": { "comparedTargets": { "type": "integer", "minimum": 0 }, "unavailableTargets": { "type": "integer", "minimum": 0 },
        "comparedChecks": { "type": "integer", "minimum": 0 }, "unavailableChecks": { "type": "integer", "minimum": 0 },
        "notChecked": { "type": "integer", "minimum": 0 } } },
    "diagnostics": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code", "reason", "message"],
      "properties": { "code": { "type": "string" }, "reason": { "type": "string" }, "message": { "type": "string" } } } },
    "limits": { "type": "object", "additionalProperties": false, "required": ["budgetMs", "elapsedMs", "targetBytes", "materialBytes"],
      "properties": { "budgetMs": { "type": "integer", "minimum": 0 }, "elapsedMs": { "type": "integer", "minimum": 0 },
        "targetBytes": { "type": "integer", "minimum": 0 }, "materialBytes": { "type": "integer", "minimum": 0 } } }
  }
}
