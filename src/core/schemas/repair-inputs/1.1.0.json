{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:repair-inputs:1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "route", "repairs", "macosSession"],
  "properties": {
    "schema": { "const": "urn:aihq:core:repair-inputs:1.1.0" },
    "route": { "enum": ["native", "file"] },
    "repairs": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": { "enum": ["node-npm-ca", "user-tools-ca", "jvm-ca"] },
      "additionalProperties": { "$ref": "#/$defs/inputRecord" }
    },
    "sources": { "$ref": "#/$defs/trustSources" },
    "macosSession": { "$ref": "#/$defs/macosSession" }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "route": { "const": "file" } }, "required": ["route"] },
      "then": { "type": "object", "properties": { "sources": {} }, "required": ["sources"] }
    },
    {
      "if": { "type": "object", "properties": { "route": { "const": "native" } }, "required": ["route"] },
      "then": { "not": { "type": "object", "properties": { "sources": {} }, "required": ["sources"] } }
    },
    {
      "if": { "type": "object", "properties": { "route": { "const": "native" } }, "required": ["route"] },
      "then": {
        "type": "object",
        "properties": {
          "repairs": {
            "type": "object",
            "additionalProperties": { "type": "object", "propertyNames": { "not": { "const": "baselineStore" } } }
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "route": { "const": "file" } }, "required": ["route"] },
      "then": {
        "type": "object",
        "properties": {
          "repairs": {
            "type": "object",
            "properties": { "jvm-ca": { "type": "object", "properties": { "baselineStore": {} }, "required": ["baselineStore"] } }
          }
        }
      }
    }
  ],
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "inputRecord": {
      "type": "object",
      "propertyNames": { "not": { "const": "caFile" } },
      "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "boolean" }, { "type": "number" }] }
    },
    "suppliedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": { "$ref": "#/$defs/sourceId" },
        "file": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "trustSources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "supplied"],
      "properties": {
        "os": { "type": "boolean" },
        "supplied": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/suppliedSource" }
        },
        "removeSupplied": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "macosSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "applications"],
      "properties": {
        "context": { "enum": ["terminal", "desktop", "both"] },
        "applications": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/macosApplication" }
        }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "context": { "const": "terminal" } }, "required": ["context"] },
          "then": { "type": "object", "properties": { "applications": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "type": "object", "properties": { "context": { "enum": ["desktop", "both"] } }, "required": ["context"] },
          "then": { "type": "object", "properties": { "applications": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "macosApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "appPath", "targets", "launch"],
      "properties": {
        "clientId": { "enum": ["claude", "codex", "cursor", "gemini", "copilot", "windsurf", "opencode", "kimi", "kiro", "antigravity", "zed"] },
        "appPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["node", "npm", "python", "pip", "git", "cargo", "conda", "gradle", "maven"] }
        },
        "launch": { "enum": ["finder", "dock"] }
      }
    }
  }
}
