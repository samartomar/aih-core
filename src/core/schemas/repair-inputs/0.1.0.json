{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:repair-inputs:0.1.0",
  "title": "The input values for `aih repair`; supplied paths resolve from this document's folder",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "urn:aihq:core:repair-inputs:0.1.0"
    },
    "route": {
      "enum": [
        "file",
        "native"
      ]
    },
    "sources": {
      "$ref": "#/$defs/trustSources"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "route": {
            "const": "native"
          }
        },
        "required": [
          "route"
        ]
      },
      "then": {
        "not": {
          "type": "object",
          "properties": {
            "sources": {}
          },
          "required": [
            "sources"
          ]
        }
      }
    }
  ],
  "$defs": {
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "suppliedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sourceId"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "trustSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "supplied"
      ],
      "properties": {
        "os": {
          "type": "boolean"
        },
        "supplied": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/suppliedSource"
          }
        },
        "removeSupplied": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceId"
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$",
        "not": {
          "const": "caFile"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 4096
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          }
        ]
      }
    }
  }
}
