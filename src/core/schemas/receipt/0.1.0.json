{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:receipt:0.1.0",
  "title": "Core receipt (ownership record inside Core's state)",
  "description": "One receipt per root Core wrote into: the members Core owns there, each member's claims, item facts and created folders. Core reads only this version; a record of any other version is not admitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target", "members"],
  "properties": {
    "schema": { "const": "urn:aihq:core:receipt:0.1.0" },
    "target": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "members": {
      "type": "object",
      "maxProperties": 8192,
      "additionalProperties": { "$ref": "#/$defs/member" }
    },
    "selections": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": { "$ref": "#/$defs/claim" }
    },
    "directories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "identity"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "identity": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "items": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4096,
      "additionalProperties": { "$ref": "#/$defs/item" }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "framework", "item", "origins"],
        "properties": {
          "name": { "type": ["string", "null"] },
          "kind": { "type": ["string", "null"] },
          "framework": { "type": ["string", "null"] },
          "item": {},
          "origins": { "type": "array" }
        }
      }
    }
  },
  "dependentRequired": { "items": ["facts"], "facts": ["items"] },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "managementId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "scope": { "enum": ["project", "user"] },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "managementId": { "$ref": "#/$defs/managementId" },
        "scope": { "$ref": "#/$defs/scope" },
        "sets": { "type": "array" },
        "requires": { "type": "array" }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managementId", "recipeIdentity", "sha256", "mode"],
      "properties": {
        "managementId": { "$ref": "#/$defs/managementId" },
        "recipeIdentity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "path": { "type": "string", "minLength": 1 },
        "descriptor": { "type": "object" },
        "claims": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/claim" } },
        "canonicalSha256": { "$ref": "#/$defs/sha256" },
        "tomlTable": { "type": "string" },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool"],
          "properties": { "tool": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" } }
        },
        "createdContainer": { "const": true },
        "createdFile": { "const": true },
        "createdContainers": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
        "sharedContent": { "type": "string", "maxLength": 65536 },
        "displaced": { "type": "object" }
      }
    },
    "item": {
      "type": "object",
      "required": ["facts", "managementId", "scope"],
      "properties": {
        "facts": { "type": "integer", "minimum": 0 },
        "managementId": { "$ref": "#/$defs/managementId" },
        "scope": { "$ref": "#/$defs/scope" },
        "plan": {
          "type": "object",
          "required": ["items", "managementId", "cli", "project", "clis", "data", "origin", "catalog", "profiles", "steps"],
          "properties": {
            "items": { "type": "array", "items": { "type": "string" } },
            "managementId": { "$ref": "#/$defs/managementId" },
            "cli": { "type": ["string", "null"] },
            "project": { "type": ["string", "null"] },
            "clis": { "type": "array", "items": { "type": "string" } },
            "data": {},
            "origin": {},
            "catalog": {},
            "profiles": { "type": "array" },
            "steps": { "type": "array" }
          }
        }
      }
    }
  }
}
