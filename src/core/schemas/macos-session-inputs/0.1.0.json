{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:macos-session-inputs:0.1.0",
  "title": "The input values for `aih repair` with a macOS session; paths resolve from this document's folder",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session"
  ],
  "properties": {
    "schema": {
      "const": "urn:aihq:core:macos-session-inputs:0.1.0"
    },
    "route": {
      "enum": [
        "file",
        "native"
      ]
    },
    "sources": {
      "$ref": "#/$defs/trustSources"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "session": {
      "$ref": "#/$defs/session"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "route": {
            "const": "native"
          }
        },
        "required": [
          "route"
        ]
      },
      "then": {
        "not": {
          "type": "object",
          "properties": {
            "sources": {}
          },
          "required": [
            "sources"
          ]
        }
      }
    }
  ],
  "$defs": {
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "suppliedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sourceId"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "trustSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "supplied"
      ],
      "properties": {
        "os": {
          "type": "boolean"
        },
        "supplied": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/suppliedSource"
          }
        },
        "removeSupplied": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceId"
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$",
        "not": {
          "const": "caFile"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 4096
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          }
        ]
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "applications"
      ],
      "properties": {
        "context": {
          "enum": [
            "terminal",
            "desktop",
            "both"
          ]
        },
        "applications": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/application"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "context": {
                "const": "terminal"
              }
            },
            "required": [
              "context"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "applications": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "context": {
                "enum": [
                  "desktop",
                  "both"
                ]
              }
            },
            "required": [
              "context"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "applications": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientId",
        "appPath",
        "targets",
        "launch"
      ],
      "properties": {
        "clientId": {
          "enum": [
            "claude",
            "codex",
            "cursor",
            "gemini",
            "copilot",
            "windsurf",
            "opencode",
            "kimi",
            "kiro",
            "antigravity",
            "zed"
          ]
        },
        "appPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "node",
              "npm",
              "python",
              "pip",
              "git",
              "cargo",
              "conda",
              "gradle",
              "maven"
            ]
          }
        },
        "launch": {
          "enum": [
            "finder",
            "dock"
          ]
        }
      }
    }
  }
}
