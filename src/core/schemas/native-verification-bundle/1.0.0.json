{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:native-verification-bundle:1.0.0",
  "title": "Native verification bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "client", "adapterId", "scope", "package", "release", "selection",
    "startingTree", "startingTreeSha256", "outputTree", "outputTreeSha256", "instructions", "server"],
  "properties": {
    "schema": { "const": "urn:aihq:core:native-verification-bundle:1.0.0" },
    "id": { "$ref": "#/$defs/nativeId" },
    "client": { "$ref": "#/$defs/clientId" },
    "adapterId": { "$ref": "#/$defs/nativeId" },
    "scope": { "enum": ["test-configuration", "production-configuration"] },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "release": { "$ref": "#/$defs/member" },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "itemSha256", "recipe", "inputs"],
      "properties": {
        "itemId": { "$ref": "#/$defs/nativeId" },
        "itemSha256": { "$ref": "#/$defs/sha256" },
        "recipe": { "$ref": "#/$defs/member" },
        "inputs": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": { "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] }
        }
      }
    },
    "startingTree": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/treeFile" } },
    "startingTreeSha256": { "$ref": "#/$defs/sha256" },
    "outputTree": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/treeFile" } },
    "outputTreeSha256": { "$ref": "#/$defs/sha256" },
    "instructions": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/instruction" } },
    "server": { "$ref": "#/$defs/server" }
  },
  "$defs": {
    "nativeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "clientId": {
      "enum": ["claude", "codex", "cursor", "gemini", "copilot", "windsurf", "opencode", "kimi", "kiro", "antigravity", "zed"]
    },
    "memberPath": {
      "type": "string",
      "minLength": 9,
      "maxLength": 512,
      "pattern": "^(?!package/.*[. ](?:/|$))(?!package/(?:.*/)?(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.[^/]*)?(?:/|$))package/[^\\\\/:\\u0000-\\u001f\\u007f<>\"|?*\\p{Cf}]+(?:/[^\\\\/:\\u0000-\\u001f\\u007f<>\"|?*\\p{Cf}]+)*$"
    },
    "treePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*[. ](?:/|$))(?!.*(?:/|^)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.[^/]*)?(?:/|$))[^\\\\/:\\u0000-\\u001f\\u007f<>\"|?*\\p{Cf}]+(?:/[^\\\\/:\\u0000-\\u001f\\u007f<>\"|?*\\p{Cf}]+)*$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byteLength"],
      "properties": {
        "path": { "$ref": "#/$defs/memberPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 8388608 }
      }
    },
    "treeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path", "member"],
      "properties": {
        "root": { "enum": ["home", "project"] },
        "path": { "$ref": "#/$defs/treePath" },
        "member": { "$ref": "#/$defs/member" }
      }
    },
    "instruction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "path", "sha256", "evidence"],
          "properties": {
            "root": { "enum": ["home", "project"] },
            "path": { "$ref": "#/$defs/treePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "evidence": { "const": "native" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "path", "sha256", "evidence", "markerSha256"],
          "properties": {
            "root": { "enum": ["home", "project"] },
            "path": { "$ref": "#/$defs/treePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "evidence": { "const": "marker" },
            "markerSha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/jsonValue" } },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "transport", "runtime", "evidenceAdapterId", "observation", "toolNames",
        "queryTool", "queryArguments", "challenge", "expectedResultSha256", "expectedAnswer"],
      "properties": {
        "name": { "$ref": "#/$defs/nativeId" },
        "transport": { "const": "stdio" },
        "runtime": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/member" } },
        "evidenceAdapterId": { "$ref": "#/$defs/nativeId" },
        "observation": { "enum": ["native", "recorder"] },
        "recorder": { "$ref": "#/$defs/member" },
        "toolNames": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/nativeId" } },
        "queryTool": { "$ref": "#/$defs/nativeId" },
        "queryArguments": { "$ref": "#/$defs/jsonObject" },
        "challenge": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "field"],
              "properties": {
                "mode": { "const": "argument" },
                "field": { "$ref": "#/$defs/nativeId" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "const": "rpc-id" } }
            }
          ]
        },
        "expectedResultSha256": { "$ref": "#/$defs/sha256" },
        "expectedAnswer": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "allOf": [
        {
          "if": { "properties": { "observation": { "const": "recorder" } }, "required": ["observation"] },
          "then": { "required": ["recorder"], "properties": { "recorder": { "$ref": "#/$defs/member" } } },
          "else": { "not": { "required": ["recorder"], "properties": { "recorder": {} } } }
        }
      ]
    }
  }
}
