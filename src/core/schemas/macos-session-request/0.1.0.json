{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:macos-session-request:0.1.0",
  "title": "A trust repair together with the macOS session it reaches (contract 10)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repair",
    "targets",
    "session"
  ],
  "properties": {
    "schema": {
      "const": "urn:aihq:core:macos-session-request:0.1.0"
    },
    "repair": {
      "enum": [
        "node-npm-ca",
        "user-tools-ca",
        "jvm-ca"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "node",
          "npm",
          "python",
          "pip",
          "git",
          "cargo",
          "conda",
          "gradle",
          "maven"
        ]
      }
    },
    "route": {
      "enum": [
        "file",
        "native"
      ]
    },
    "sources": {
      "$ref": "#/$defs/trustSources"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "network": {
      "enum": [
        "declared",
        "off"
      ]
    },
    "resolutions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/resolution"
      }
    },
    "session": {
      "$ref": "#/$defs/session"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "repair": {
            "const": "node-npm-ca"
          }
        },
        "required": [
          "repair"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "targets": {
            "type": "array",
            "items": {
              "enum": [
                "node",
                "npm"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "repair": {
            "const": "user-tools-ca"
          }
        },
        "required": [
          "repair"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "targets": {
            "type": "array",
            "items": {
              "enum": [
                "python",
                "pip",
                "git",
                "cargo",
                "conda"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "repair": {
            "const": "jvm-ca"
          }
        },
        "required": [
          "repair"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "targets": {
            "type": "array",
            "items": {
              "enum": [
                "gradle",
                "maven"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "route": {
            "const": "native"
          }
        },
        "required": [
          "route"
        ]
      },
      "then": {
        "not": {
          "type": "object",
          "properties": {
            "sources": {}
          },
          "required": [
            "sources"
          ]
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "suppliedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sourceId"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "trustSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "supplied"
      ],
      "properties": {
        "os": {
          "type": "boolean"
        },
        "supplied": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/suppliedSource"
          }
        },
        "removeSupplied": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceId"
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$",
        "not": {
          "const": "caFile"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 4096
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          }
        ]
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managementId",
        "step",
        "choice",
        "observedSha256"
      ],
      "properties": {
        "managementId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "choice": {
          "const": "replace"
        },
        "observedSha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "applications"
      ],
      "properties": {
        "context": {
          "enum": [
            "terminal",
            "desktop",
            "both"
          ]
        },
        "applications": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/application"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "context": {
                "const": "terminal"
              }
            },
            "required": [
              "context"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "applications": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "context": {
                "enum": [
                  "desktop",
                  "both"
                ]
              }
            },
            "required": [
              "context"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "applications": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientId",
        "appPath",
        "targets",
        "launch"
      ],
      "properties": {
        "clientId": {
          "enum": [
            "claude",
            "codex",
            "cursor",
            "gemini",
            "copilot",
            "windsurf",
            "opencode",
            "kimi",
            "kiro",
            "antigravity",
            "zed"
          ]
        },
        "appPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "node",
              "npm",
              "python",
              "pip",
              "git",
              "cargo",
              "conda",
              "gradle",
              "maven"
            ]
          }
        },
        "launch": {
          "enum": [
            "finder",
            "dock"
          ]
        }
      }
    }
  }
}
