{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:inventory:0.1.0",
  "title": "What list returns: each management id in a place, with its items, origin, CLIs and member states",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "target", "scope", "observation", "entries"],
  "properties": {
    "schema": { "const": "urn:aihq:core:inventory:0.1.0" },
    "status": { "const": "ok" },
    "target": { "type": "object", "additionalProperties": false, "required": ["project"],
      "properties": { "project": { "type": ["string", "null"] } } },
    "scope": { "enum": ["project", "user", "both"] },
    "observation": { "enum": ["complete", "incomplete"] },
    "entries": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["managementId", "scope", "items", "origin", "data", "clis", "installState", "members"],
      "properties": {
        "managementId": { "type": "string" },
        "scope": { "enum": ["project", "user"] },
        "items": { "type": "array", "items": { "type": "string" } },
        "origin": { "oneOf": [{ "type": "null" }, { "const": "chosen" }, { "type": "object", "additionalProperties": false, "required": ["recipe", "data"],
          "description": "A proven recipe origin (8.2)",
          "properties": {
            "recipe": { "type": "object", "additionalProperties": false, "required": ["id", "sha256", "repository", "commit"],
              "properties": { "id": { "type": "string" }, "sha256": { "type": "string" }, "repository": { "type": "string" }, "commit": { "type": "string" } } },
            "data": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
              "properties": { "repository": { "type": "string" }, "commit": { "type": "string" } } }] } } }] },
        "catalog": { "oneOf": [{ "type": "string" }, { "type": "null" }], "description": "The caller's Catalog version recorded at install, or null" },
        "profiles": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": { "id": { "type": "string" }, "version": { "oneOf": [{ "type": "string" }, { "type": "integer" }] } } } },
        "data": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
          "properties": { "repository": { "type": "string" }, "commit": { "type": "string" } } }] },
        "clis": { "type": "array", "items": { "type": "string" } },
        "installState": { "enum": ["complete", "interrupted"] },
        "aiSetup": { "type": "object", "additionalProperties": false, "required": ["branch", "interpreter", "fallback", "fallbackReason"],
          "properties": { "branch": { "enum": ["installed", "fallback", null] },
            "interpreter": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["path", "version"],
              "properties": { "path": { "type": "string" }, "version": { "type": "string" } } }] },
            "fallback": { "type": "boolean" }, "fallbackReason": { "type": ["string", "null"] } } },
        "localPlugin": { "type": "object", "additionalProperties": false, "required": ["contains", "files"], "properties": {
          "contains": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "type": "string" } }] },
          "files": { "type": "array", "items": { "type": "string" } } } },
        "switchOff": { "type": "object", "additionalProperties": false, "required": ["framework", "item", "cli", "name"], "properties": {
          "framework": { "type": "string" }, "item": { "type": "string" }, "cli": { "type": "string" }, "name": { "type": "string" } } },
        "members": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["kind", "path", "state"],
          "properties": {
            "kind": { "type": "string" }, "path": { "type": "string" }, "pointer": { "type": "string" }, "blockId": { "type": "string" },
            "linkType": { "enum": ["junction", "symlink", "copy"] },
            "state": { "enum": ["matching", "changed-by-you", "missing", "unchecked"] }
          } } },
        "plugins": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["step", "cli", "plugin", "commit", "contains", "undo", "presenceCheck"],
          "properties": {
            "step": { "type": "integer", "minimum": 0 }, "cli": { "type": "string" }, "plugin": { "type": "string" }, "commit": { "type": "string" },
            "contains": { "type": "array", "items": { "type": "string" } },
            "skills": { "type": "object", "additionalProperties": { "type": "string" } },
            "undo": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } }] },
            "presenceCheck": { "oneOf": [{ "const": "none" }, { "type": "object", "additionalProperties": false, "required": ["argv", "expect"],
              "properties": { "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "expect": { "type": "string" } } }] }
          } } },
        "programs": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["step", "op", "argv", "executable", "managed", "undo"],
          "properties": {
            "step": { "type": "integer", "minimum": 0 }, "op": { "enum": ["tool-command", "upstream-installer", "upstream-setup"] },
            "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "executable": { "type": ["string", "null"] }, "managed": { "type": "boolean" },
            "undo": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["argv", "readback"],
              "properties": { "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "readback": { "type": "object", "additionalProperties": false, "required": ["argv", "expected"], "properties": { "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "expected": { "type": "string" } } } } }] },
            "clone": { "type": "object", "additionalProperties": false, "required": ["repository", "commit", "into"],
              "properties": { "repository": { "type": "string" }, "commit": { "type": "string" }, "into": { "type": "string" } } }
          } } }
      } } }
  }
}
