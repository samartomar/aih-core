{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:review:0.1.0",
  "title": "A frozen review: every effect Apply may have, bound by its reviewDigest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request", "scope", "target", "steps", "conflicts", "failureRule", "warnings", "reviewDigest"],
  "properties": {
    "schema": { "const": "urn:aihq:core:review:0.1.0" },
    "request": { "enum": ["plan", "removal", "change", "update", "repair", "export", "macos-session"] },
    "scope": { "enum": ["project", "user"] },
    "target": { "type": "object", "additionalProperties": false, "required": ["project"],
      "properties": { "project": { "type": ["string", "null"] } } },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "data", "missing", "unavailable", "clashes", "duplicates", "references", "warnings"],
      "properties": {
        "status": { "enum": ["ok", "incomplete"] },
        "data": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
          "properties": { "repository": { "type": "string" }, "commit": { "type": "string" } } }] },
        "recipe": { "type": "object", "additionalProperties": false, "required": ["id", "sha256", "repository", "commit"],
          "properties": { "id": { "type": "string" }, "sha256": { "type": "string" }, "repository": { "type": "string" }, "commit": { "type": "string" } } },
        "profiles": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": { "id": { "type": "string" }, "version": { "oneOf": [{ "type": "string" }, { "type": "integer" }] } } } },
        "missing": { "type": "array" }, "unavailable": { "type": "array" }, "clashes": { "type": "array" },
        "duplicates": { "type": "array" }, "references": { "type": "array" }, "warnings": { "type": "array" }
      }
    },
    "origin": { "oneOf": [{ "const": "chosen" }, { "type": "object", "additionalProperties": false, "required": ["recipe", "data"],
          "description": "A proven recipe origin (8.2)",
          "properties": {
            "recipe": { "type": "object", "additionalProperties": false, "required": ["id", "sha256", "repository", "commit"],
              "properties": { "id": { "type": "string" }, "sha256": { "type": "string" }, "repository": { "type": "string" }, "commit": { "type": "string" } } },
            "data": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
              "properties": { "repository": { "type": "string" }, "commit": { "type": "string" } } }] } } }] },
    "originNote": { "type": ["string", "null"] },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
    "ignoredFiles": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["sourceId", "sourcePath"],
      "properties": { "sourceId": { "type": "string" }, "sourcePath": { "type": "string" } } } },
    "groups": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "members"],
      "properties": { "id": { "type": "string" }, "members": { "type": "array", "items": { "type": "string" } } } } },
    "failureRule": { "type": "string" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "versions": { "description": "D110: each served CLI's installed version against its profile's checkedWith; an older CLI is a warning, never a stop.",
      "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["tool", "installed", "comparison", "message"],
      "properties": { "tool": { "type": "string" }, "installed": { "type": ["string", "null"] },
        "comparison": { "enum": ["older", "not-older", "not-compared"] },
        "reason": { "enum": ["no-profile", "not-installed", "not-inspected", "version-unknown", "version-unparsed", "checked-app-unmatched"] },
        "profile": { "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": { "id": { "type": "string" }, "version": { "oneOf": [{ "type": "string" }, { "type": "integer" }] } } },
        "checkedWith": { "type": "object", "additionalProperties": false, "required": ["app", "version"],
          "properties": { "app": { "type": "string" }, "version": { "type": "string" } } },
        "message": { "type": "string" } } } },
    "environment": { "$ref": "#/$defs/environment" },
    "reviewDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "environment": {
      "description": "Repair, certificate export and macOS session facts (contract 10): what was found, what is admitted, and why anything is unavailable",
      "type": "object", "additionalProperties": false,
      "required": ["job", "repair", "targets", "route", "network", "facts", "observations", "unavailable"],
      "properties": {
        "job": { "enum": ["repair", "export", "macos-session"] },
        "repair": { "type": ["string", "null"] },
        "targets": { "type": "array", "items": { "type": "string" } },
        "route": { "enum": ["file", "native", "os", "export"] },
        "network": { "enum": ["declared", "off"] },
        "facts": { "type": "object" },
        "observations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "reason"],
          "properties": { "id": { "type": "string" }, "reason": { "type": "string" } } } },
        "unavailable": { "type": "array", "items": { "$ref": "#/$defs/environmentProblem" } }
      }
    },
    "environmentProblem": {
      "type": "object", "additionalProperties": false, "required": ["code", "reason", "message"],
      "properties": { "code": { "type": "string" }, "reason": { "type": "string" }, "message": { "type": "string" }, "path": { "type": "string" } }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["step", "op", "managementId", "sentence", "cantPromise", "effect"],
      "properties": {
        "step": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "minLength": 1 }] },
        "op": { "type": "string" },
        "managementId": { "type": "string" },
        "sentence": { "type": "string" },
        "cantPromise": { "type": ["string", "null"] },
        "effect": { "enum": ["create-file", "replace-file", "remove-file", "already-satisfied", "conflict", "skipped", "unchanged", "run-program", "opaque-process", "unavailable"] },
        "displaces": { "type": "array", "items": { "type": "string" }, "description": "A reviewed replace that displaces other installs' shared value (C61): their management ids" },
        "root": { "enum": ["project", "user"] },
        "path": { "type": "string" },
        "item": { "type": "string" },
        "items": { "type": "array", "items": { "type": "string" } },
        "clis": { "type": "array", "items": { "type": "string" } },
        "to": { "type": "string", "description": "A link step: the folder it points to, under the user root" },
        "linkType": { "enum": ["junction", "symlink", "copy"], "description": "How a link step lands on this host (C29)" },
        "requires": { "type": "array", "items": { "type": "string" } },
        "details": { "type": "object" },
        "acquire": { "type": "object", "additionalProperties": false,
          "required": ["aiSetup", "version", "cell", "kind", "qualification", "artifact", "into", "members", "closure"],
          "properties": {
            "aiSetup": { "type": "string" }, "version": { "type": "string" }, "cell": { "type": "string" },
            "kind": { "enum": ["pypi-wheel", "native-archive"] },
            "qualification": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "artifact": { "type": "object", "additionalProperties": false, "required": ["file", "sha256"],
              "properties": { "file": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
            "into": { "type": "string" }, "members": { "type": "integer", "minimum": 0 }, "closure": { "type": "integer", "minimum": 0 }
          } },
        "interpreter": { "type": "object", "additionalProperties": false, "required": ["installed", "range", "fallback", "switchesOn"],
          "properties": {
            "installed": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["path", "version", "note"],
              "properties": { "path": { "type": "string" }, "version": { "type": "string" }, "note": { "const": "in range, not qualified" } } }] },
            "range": { "type": "string" },
            "fallback": { "type": "object", "additionalProperties": false, "required": ["version", "file", "sha256"],
              "properties": { "version": { "type": "string" }, "file": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
            "switchesOn": { "type": "array", "items": { "enum": ["none-found", "outside-range", "wheel-install-failed", "readback-failed"] } }
          } },
        "format": { "enum": ["json", "toml", "markdown"] },
        "key": { "type": "string" },
        "entry": {},
        "inputs": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/input" } },
        "framework": { "type": "string" },
        "cli": { "type": "string" },
        "plugin": { "type": "string" },
        "commit": { "type": "string" },
        "contains": { "type": "array", "items": { "type": "string" } },
        "route": { "const": "local-plugin" },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "undo": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "$ref": "#/$defs/argv" } }] },
        "presenceCheck": { "oneOf": [{ "const": "none" }, {
          "type": "object", "additionalProperties": false, "required": ["argv", "executable", "executableSha256", "expect"],
          "properties": { "argv": { "$ref": "#/$defs/argv" }, "executable": { "type": "string" },
            "executableSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "expect": { "type": "string", "minLength": 1 } } }] },
        "previous": { "const": "interrupted" },
        "program": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "argv", "executable", "executableSha256", "from", "cwd", "env", "managed", "readback", "undo", "cantRemove"],
          "properties": {
            "kind": { "enum": ["tool-command", "upstream-installer", "upstream-setup"] }, "argv": { "$ref": "#/$defs/argv" },
            "executable": { "type": "string" }, "executableSha256": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }] },
            "from": { "enum": ["path", "acquired", "clone"] }, "cwd": { "type": "string" },
            "env": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "value"],
              "properties": { "name": { "type": "string" }, "value": { "type": "string" } } } },
            "managed": { "type": "boolean" }, "readback": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["argv", "expected"], "properties": { "argv": { "$ref": "#/$defs/argv" }, "expected": { "type": "string" } } }] },
            "undo": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["argv", "readback"],
              "properties": { "argv": { "$ref": "#/$defs/argv" }, "readback": { "type": "object", "additionalProperties": false, "required": ["argv", "expected"], "properties": { "argv": { "$ref": "#/$defs/argv" }, "expected": { "type": "string" } } } } }] },
            "cantRemove": { "type": "string" },
            "clone": { "type": "object", "additionalProperties": false, "required": ["repository", "commit", "into", "git", "gitSha256"],
              "properties": { "repository": { "type": "string" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "into": { "type": "string" },
                "git": { "type": "string" }, "gitSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
            "needs": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "input": {
      "description": "One input binding of a step (C59): where its value lands and how it is written. A secret's value never appears.",
      "type": "object", "additionalProperties": false, "required": ["item", "input", "at", "secret", "written", "from"],
      "properties": {
        "item": { "type": "string" },
        "input": { "type": "string" },
        "at": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["pointer"], "properties": { "pointer": { "type": "string" } } },
          { "type": "object", "additionalProperties": false, "required": ["placeholder"], "properties": { "placeholder": { "type": "string" } } },
          { "type": "object", "additionalProperties": false, "required": ["argv"], "properties": { "argv": { "type": "integer", "minimum": 0 } } },
          { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string" } } } ] },
        "secret": { "type": "boolean" },
        "written": { "enum": ["value", "reference", "omitted"] },
        "from": { "enum": [null, "inputs", "default", "privateInputs"] },
        "value": { "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] }
      },
      "if": { "properties": { "secret": { "const": true } } }, "then": { "properties": { "value": false } }
    },
    "command": {
      "type": "object", "additionalProperties": false, "required": ["argv", "executable", "executableSha256"],
      "properties": {
        "argv": { "$ref": "#/$defs/argv" },
        "executable": { "type": "string" },
        "executableSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "reason", "managementId", "step", "target", "observedSha256", "existing", "redacted", "choices"],
      "properties": {
        "code": { "const": "STATE_CONFLICT" },
        "reason": { "enum": ["existing-content", "managed-content-changed", "second-displacement"] },
        "managementId": { "type": "string" },
        "step": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "minLength": 1 }] },
        "target": { "type": "string" },
        "key": { "type": "string" },
        "observedSha256": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }] },
        "existing": { "type": ["string", "null"] },
        "redacted": { "type": "array", "items": { "type": "string" } },
        "choices": { "type": "array", "items": { "enum": ["replace", "adopt", "skip"] } },
        "detail": { "type": "string" },
        "displaces": { "type": "array", "items": { "type": "string" }, "description": "The installs whose shared value a reviewed replace would displace (C61)" },
        "displacedBy": { "type": "array", "items": { "type": "string" }, "description": "second-displacement (C75): the installs that hold the value now" },
        "displaced": { "type": "array", "items": { "type": "string" }, "description": "second-displacement (C75): the installs those already displace" },
        "fix": { "type": "string", "description": "second-displacement: remove the overriding install through review first, then prepare again" }
      }
    }
  }
}
