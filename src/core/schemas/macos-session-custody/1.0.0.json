{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:macos-session-custody:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "schema": { "const": "urn:aihq:core:macos-session-custody:1.0.0" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "utcInstant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "value"],
      "properties": {
        "present": { "type": "boolean" },
        "value": { "type": ["string", "null"], "maxLength": 4096 }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "present": { "const": false } }, "required": ["present"] },
          "then": { "type": "object", "properties": { "value": { "type": "null" } } }
        },
        {
          "if": { "type": "object", "properties": { "present": { "const": true } }, "required": ["present"] },
          "then": { "type": "object", "properties": { "value": { "type": "string" } } }
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "pathKey", "sha256"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pathKey": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "plistPathKey", "helperSha256", "desired", "sessionIdentitySha256", "before", "after"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "label": { "type": "string", "minLength": 1, "maxLength": 256 },
        "plistPathKey": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "helperSha256": { "$ref": "#/$defs/sha256" },
        "desired": { "$ref": "#/$defs/presence" },
        "sessionIdentitySha256": { "$ref": "#/$defs/sha256" },
        "before": { "$ref": "#/$defs/presence" },
        "after": { "$ref": "#/$defs/presence" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managementId", "selectionId", "recipeIdentity", "bindingSha256", "context", "request", "files", "keys", "profileIds", "appBindingSha256", "appliedAt"],
      "properties": {
        "managementId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "selectionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recipeIdentity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "bindingSha256": { "$ref": "#/$defs/sha256" },
        "context": { "enum": ["terminal", "desktop", "both"] },
        "request": { "$ref": "urn:aihq:core:repair-request:1.1.0" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/file" }
        },
        "keys": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/key" }
        },
        "profileIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "appBindingSha256": { "$ref": "#/$defs/sha256" },
        "appliedAt": { "$ref": "#/$defs/utcInstant" }
      }
    }
  }
}
