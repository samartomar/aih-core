{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:tool-registry:0.1.0",
  "title": "Tool registry",
  "description": "Every AI tool Core knows, with a stable id, its surface, the command names inspection looks for and the aliases accepted for selection only (contract 6, C37, C73). Ids match Catalog's profile ids; aliases never appear in plans, receipts or organization documents.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tools"],
  "properties": {
    "schema": { "const": "urn:aihq:core:tool-registry:0.1.0" },
    "tools": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/tool" } }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "surface", "binaries", "aliases"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "surface": { "enum": ["cli", "ide"] },
        "binaries": { "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" } },
        "aliases": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } }
      }
    }
  }
}
