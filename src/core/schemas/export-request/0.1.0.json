{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:export-request:0.1.0",
  "title": "A standalone certificate export (contract 10)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "urn:aihq:core:export-request:0.1.0"
    },
    "format": {
      "enum": [
        "pem",
        "pkcs7-der"
      ]
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sources": {
      "$ref": "#/$defs/trustSources"
    },
    "network": {
      "enum": [
        "declared",
        "off"
      ]
    },
    "resolutions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/resolution"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "suppliedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sourceId"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "trustSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "supplied"
      ],
      "properties": {
        "os": {
          "type": "boolean"
        },
        "supplied": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/suppliedSource"
          }
        },
        "removeSupplied": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceId"
          }
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managementId",
        "step",
        "choice",
        "observedSha256"
      ],
      "properties": {
        "managementId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "choice": {
          "const": "replace"
        },
        "observedSha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        }
      }
    }
  }
}
