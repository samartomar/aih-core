{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:execution-policy:1.4.0",
  "title": "Core execution policy with descriptive Catalog selection metadata and excluded items",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "selections"
  ],
  "properties": {
    "schema": {
      "const": "urn:aihq:core:execution-policy:1.4.0"
    },
    "mode": {
      "enum": [
        "vibe",
        "enterprise"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "scanId",
          "location"
        ],
        "properties": {
          "schema": {
            "const": "urn:aihq:scan:evidence-association:1.0.0"
          },
          "scanId": {
            "type": "string",
            "pattern": "^scan:sha256:[a-f0-9]{64}$"
          },
          "location": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "path"
                ],
                "properties": {
                  "kind": {
                    "const": "file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "url"
                ],
                "properties": {
                  "kind": {
                    "const": "https"
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              }
            ]
          }
        }
      }
    },
    "managedSelections": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "members"
        ],
        "properties": {
          "id": {
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id"
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "members": {
            "type": "array",
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/ids",
            "maxItems": 4096
          }
        }
      }
    },
    "removals": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "managementId",
          "scope"
        ],
        "properties": {
          "managementId": {
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id"
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          }
        }
      }
    },
    "selections": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "managementId",
          "scope",
          "configuration",
          "requires",
          "recipe"
        ],
        "properties": {
          "id": {
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id"
          },
          "managementId": {
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id"
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "configuration": {
            "type": "object"
          },
          "organizationSelectionId": {
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id"
          },
          "requires": {
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/ids"
          },
          "recipe": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "inline"
                ],
                "properties": {
                  "inline": {
                    "oneOf": [
                      {
                        "$ref": "urn:aihq:core:recipe:1.0.0"
                      },
                      {
                        "$ref": "urn:aihq:core:recipe:1.1.0"
                      },
                      {
                        "$ref": "urn:aihq:core:recipe:1.2.0"
                      },
                      {
                        "$ref": "urn:aihq:core:recipe:1.3.0"
                      }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reference"
                ],
                "properties": {
                  "reference": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source",
                      "path",
                      "sha256",
                      "byteLength",
                      "materials"
                    ],
                    "properties": {
                      "source": {
                        "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/source"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/sha256"
                      },
                      "byteLength": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      },
                      "materials": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "id",
                            "path",
                            "sha256",
                            "byteLength"
                          ],
                          "properties": {
                            "id": {
                              "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id"
                            },
                            "path": {
                              "type": "string",
                              "minLength": 1
                            },
                            "sha256": {
                              "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/sha256"
                            },
                            "byteLength": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 16777216
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "item": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "framework",
              "itemId",
              "contentSha256",
              "behaviourSha256"
            ],
            "properties": {
              "framework": {
                "$ref": "#/$defs/catalogId"
              },
              "itemId": {
                "$ref": "#/$defs/catalogId"
              },
              "contentSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "behaviourSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "skill",
              "agent",
              "command",
              "rule",
              "hook",
              "mcp-server",
              "document"
            ]
          },
          "origins": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "$ref": "#/$defs/origin"
            }
          }
        },
        "dependentRequired": {
          "item": [
            "tool",
            "name",
            "kind",
            "origins"
          ],
          "tool": [
            "item",
            "name",
            "kind",
            "origins"
          ],
          "name": [
            "item",
            "tool",
            "kind",
            "origins"
          ],
          "kind": [
            "item",
            "tool",
            "name",
            "origins"
          ],
          "origins": [
            "item",
            "tool",
            "name",
            "kind"
          ]
        }
      }
    },
    "excludedItems": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "framework",
          "itemId"
        ],
        "properties": {
          "framework": {
            "$ref": "#/$defs/catalogId"
          },
          "itemId": {
            "$ref": "#/$defs/catalogId"
          }
        }
      }
    }
  },
  "$defs": {
    "catalogId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasonIncluded"
          ],
          "properties": {
            "reasonIncluded": {
              "const": "chosen"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasonIncluded",
            "set"
          ],
          "properties": {
            "reasonIncluded": {
              "const": "in-set"
            },
            "set": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "framework",
                "setId",
                "setSha256"
              ],
              "properties": {
                "framework": {
                  "$ref": "#/$defs/catalogId"
                },
                "setId": {
                  "$ref": "#/$defs/catalogId"
                },
                "setSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "options": {
              "type": "object",
              "maxProperties": 64,
              "propertyNames": {
                "$ref": "#/$defs/catalogId"
              },
              "additionalProperties": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "$ref": "#/$defs/catalogId"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasonIncluded",
            "requiredBy"
          ],
          "properties": {
            "reasonIncluded": {
              "const": "required-by"
            },
            "requiredBy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "itemId"
              ],
              "properties": {
                "framework": {
                  "$ref": "#/$defs/catalogId"
                },
                "itemId": {
                  "$ref": "#/$defs/catalogId"
                }
              }
            }
          }
        }
      ]
    }
  }
}
