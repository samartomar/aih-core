{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:execution-policy:1.1.0",
  "title": "Core execution policy (accepts recipe 1.0.0 and 1.1.0)",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "mode", "selections"],
  "properties": {
    "schema": { "const": "urn:aihq:core:execution-policy:1.1.0" }, "mode": { "enum": ["vibe", "enterprise"] },
    "metadata": { "type": "object" },
    "evidence": { "type": "array", "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false, "required": ["schema", "scanId", "location"],
      "properties": {
        "schema": { "const": "urn:aihq:scan:evidence-association:1.0.0" },
        "scanId": { "type": "string", "pattern": "^scan:sha256:[a-f0-9]{64}$" },
        "location": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["kind", "path"],
            "properties": { "kind": { "const": "file" }, "path": { "type": "string", "minLength": 1, "maxLength": 4096 } } },
          { "type": "object", "additionalProperties": false, "required": ["kind", "url"],
            "properties": { "kind": { "const": "https" }, "url": { "type": "string", "minLength": 1, "maxLength": 2048 } } }
        ] }
      }
    } },
    "managedSelections": { "type": "array", "maxItems": 4096, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "scope", "members"],
      "properties": { "id": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id" },
        "scope": { "enum": ["project", "user"] },
        "members": { "type": "array", "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/ids", "maxItems": 4096 } }
    } },
    "removals": { "type": "array", "maxItems": 4096, "items": {
      "type": "object", "additionalProperties": false, "required": ["managementId", "scope"],
      "properties": { "managementId": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id" }, "scope": { "enum": ["project", "user"] } }
    } },
    "selections": {
      "type": "array", "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "managementId", "scope", "configuration", "requires", "recipe"],
        "properties": {
          "id": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id" },
          "managementId": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id" },
          "scope": { "enum": ["project", "user"] }, "configuration": { "type": "object" },
          "organizationSelectionId": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id" },
          "requires": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/ids" },
          "recipe": { "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["inline"], "properties": { "inline": { "oneOf": [ { "$ref": "urn:aihq:core:recipe:1.0.0" }, { "$ref": "urn:aihq:core:recipe:1.1.0" } ] } } },
            { "type": "object", "additionalProperties": false, "required": ["reference"], "properties": { "reference": {
              "type": "object", "additionalProperties": false,
              "required": ["source", "path", "sha256", "byteLength", "materials"],
              "properties": {
                "source": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/source" },
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/sha256" },
                "byteLength": { "type": "integer", "minimum": 1, "maximum": 1000000 },
                "materials": { "type": "array", "items": { "type": "object", "additionalProperties": false,
                  "required": ["id", "path", "sha256", "byteLength"], "properties": {
                    "id": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id" }, "path": { "type": "string", "minLength": 1 },
                    "sha256": { "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/sha256" },
                    "byteLength": { "type": "integer", "minimum": 0, "maximum": 16777216 }
                  } } }
              }
            } } }
          ] }
        }
      }
    }
  }
}
