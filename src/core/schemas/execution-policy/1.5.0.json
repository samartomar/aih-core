{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:execution-policy:1.5.0",
  "title": "Core execution policy naming each selection's item, rendering binding and Scan item records",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "selections"
  ],
  "properties": {
    "schema": {
      "const": "urn:aihq:core:execution-policy:1.5.0"
    },
    "mode": {
      "enum": [
        "vibe",
        "enterprise"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "scanId",
          "location"
        ],
        "properties": {
          "schema": {
            "const": "urn:aihq:scan:evidence-association:1.0.0"
          },
          "scanId": {
            "type": "string",
            "pattern": "^scan:sha256:[a-f0-9]{64}$"
          },
          "location": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "path"
                ],
                "properties": {
                  "kind": {
                    "const": "file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "url"
                ],
                "properties": {
                  "kind": {
                    "const": "https"
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              }
            ]
          }
        }
      }
    },
    "managedSelections": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "members"
        ],
        "properties": {
          "id": {
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id"
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "members": {
            "type": "array",
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/ids",
            "maxItems": 4096
          }
        }
      }
    },
    "removals": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "managementId",
          "scope"
        ],
        "properties": {
          "managementId": {
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id"
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          }
        }
      }
    },
    "selections": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "managementId",
          "scope",
          "configuration",
          "requires",
          "recipe"
        ],
        "properties": {
          "id": {
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id"
          },
          "managementId": {
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id"
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "configuration": {
            "type": "object"
          },
          "organizationSelectionId": {
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id"
          },
          "requires": {
            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/ids"
          },
          "recipe": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "inline"
                ],
                "properties": {
                  "inline": {
                    "oneOf": [
                      {
                        "$ref": "urn:aihq:core:recipe:1.0.0"
                      },
                      {
                        "$ref": "urn:aihq:core:recipe:1.1.0"
                      },
                      {
                        "$ref": "urn:aihq:core:recipe:1.2.0"
                      },
                      {
                        "$ref": "urn:aihq:core:recipe:1.3.0"
                      },
                      {
                        "$ref": "urn:aihq:core:recipe:1.4.0"
                      }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reference"
                ],
                "properties": {
                  "reference": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source",
                      "path",
                      "sha256",
                      "byteLength",
                      "materials"
                    ],
                    "properties": {
                      "source": {
                        "oneOf": [
                          {
                            "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/source"
                          },
                          {
                            "$ref": "#/$defs/gitSource"
                          }
                        ]
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/sha256"
                      },
                      "byteLength": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      },
                      "materials": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "id",
                            "path",
                            "sha256",
                            "byteLength"
                          ],
                          "properties": {
                            "id": {
                              "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/id"
                            },
                            "path": {
                              "type": "string",
                              "minLength": 1
                            },
                            "sha256": {
                              "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/sha256"
                            },
                            "byteLength": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 16777216
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "item": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "framework",
              "itemId",
              "contentSha256",
              "behaviourSha256"
            ],
            "properties": {
              "framework": {
                "$ref": "#/$defs/catalogId"
              },
              "itemId": {
                "$ref": "#/$defs/catalogId"
              },
              "contentSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "behaviourSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "skill",
              "agent",
              "command",
              "rule",
              "hook",
              "mcp-server",
              "document"
            ]
          },
          "origins": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "$ref": "#/$defs/origin"
            }
          },
          "projectFacts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "value",
                "confidence"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][A-Za-z0-9]*$"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "confidence": {
                  "enum": [
                    "detected",
                    "inferred"
                  ]
                }
              }
            }
          },
          "bindingDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scanRecords": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/itemScanRecord"
            }
          }
        },
        "dependentRequired": {
          "item": [
            "tool",
            "name",
            "kind",
            "origins"
          ],
          "tool": [
            "item",
            "name",
            "kind",
            "origins"
          ],
          "name": [
            "item",
            "tool",
            "kind",
            "origins"
          ],
          "kind": [
            "item",
            "tool",
            "name",
            "origins"
          ],
          "origins": [
            "item",
            "tool",
            "name",
            "kind"
          ],
          "bindingDigest": [
            "item"
          ],
          "scanRecords": [
            "item"
          ]
        }
      }
    },
    "excludedItems": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "framework",
          "itemId"
        ],
        "properties": {
          "framework": {
            "$ref": "#/$defs/catalogId"
          },
          "itemId": {
            "$ref": "#/$defs/catalogId"
          }
        }
      }
    }
  },
  "$defs": {
    "catalogId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasonIncluded"
          ],
          "properties": {
            "reasonIncluded": {
              "const": "chosen"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasonIncluded",
            "set"
          ],
          "properties": {
            "reasonIncluded": {
              "const": "in-set"
            },
            "set": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "framework",
                "setId",
                "setSha256"
              ],
              "properties": {
                "framework": {
                  "$ref": "#/$defs/catalogId"
                },
                "setId": {
                  "$ref": "#/$defs/catalogId"
                },
                "setSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "options": {
              "type": "object",
              "maxProperties": 64,
              "propertyNames": {
                "$ref": "#/$defs/catalogId"
              },
              "additionalProperties": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "$ref": "#/$defs/catalogId"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasonIncluded",
            "requiredBy"
          ],
          "properties": {
            "reasonIncluded": {
              "const": "required-by"
            },
            "requiredBy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "itemId"
              ],
              "properties": {
                "framework": {
                  "$ref": "#/$defs/catalogId"
                },
                "itemId": {
                  "$ref": "#/$defs/catalogId"
                }
              }
            }
          }
        }
      ]
    },
    "gitSource": {
      "description": "An exact GitHub commit in Catalog's exact git source identity form, with the pinned archive of that commit. The repository is https://github.com/<owner>/<repo>, the commit 40 lowercase hex, reachable true, and the archive URL https://codeload.github.com/<owner>/<repo>/tar.gz/<commit>; Core's validator names each refusal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository",
        "commit",
        "reachable",
        "archive"
      ],
      "properties": {
        "kind": {
          "const": "git"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reachable": {
          "enum": [
            true,
            false,
            "unchecked"
          ]
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "sha256",
            "byteLength"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "sha256": {
              "$ref": "urn:aihq:core:recipe:1.0.0#/$defs/sha256"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          }
        }
      }
    },
    "itemScanRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanId",
        "createdAt",
        "evidenceKey",
        "subject",
        "authenticity",
        "materials",
        "completion",
        "coverage",
        "severityProfile",
        "detectors"
      ],
      "properties": {
        "schema": {
          "const": "urn:aihq:scan:item-record:1.0.0"
        },
        "scanId": {
          "type": "string",
          "pattern": "^scan:sha256:[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "evidenceKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frameworkId",
            "itemId",
            "contentSha256",
            "behaviourSha256"
          ],
          "properties": {
            "frameworkId": {
              "$ref": "#/$defs/catalogId"
            },
            "itemId": {
              "$ref": "#/$defs/catalogId"
            },
            "contentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "behaviourSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "authenticity": {
          "const": "unchecked"
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "materialId",
              "relPath",
              "sha256",
              "byteLength",
              "executable",
              "captured"
            ],
            "properties": {
              "materialId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "relPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0
              },
              "executable": {
                "type": "boolean"
              },
              "captured": {
                "type": "boolean"
              }
            }
          }
        },
        "completion": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "coverage": {
          "enum": [
            "matched",
            "mismatched",
            "unavailable",
            "invalid"
          ]
        },
        "severityProfile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "detectors": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "outcome",
              "coverage",
              "exclusions",
              "findings",
              "suppressed"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "outcome": {
                "enum": [
                  "succeeded",
                  "failed",
                  "refused",
                  "cancelled"
                ]
              },
              "coverage": {
                "enum": [
                  "matched",
                  "mismatched",
                  "unavailable",
                  "invalid"
                ]
              },
              "exclusions": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "findings": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "error",
                  "warning",
                  "note",
                  "unavailable"
                ],
                "properties": {
                  "error": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "warning": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "note": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unavailable": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "suppressed": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rule",
                    "count",
                    "reason"
                  ],
                  "properties": {
                    "rule": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  }
                }
              },
              "findingRefs": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            }
          }
        }
      }
    }
  }
}
