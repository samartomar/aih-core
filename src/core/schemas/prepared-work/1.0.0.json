{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:core:prepared-work:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "urn:aihq:core:prepared-work:1.0.0"
    },
    "useCase": {
      "enum": ["policy", "repair"]
    },
    "mode": {
      "enum": ["vibe", "enterprise", "standalone"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": ["project", "user"]
        },
        "project": {
          "type": "string"
        }
      },
      "required": [
        "scope",
        "project"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "organization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": { "const": "github" },
                "repository": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": { "owner": { "type": "string" }, "name": { "type": "string" } },
                  "required": ["owner", "name"]
                },
                "path": { "type": "string" },
                "revision": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": { "kind": { "enum": ["commit", "branch", "tag"] }, "value": { "type": "string" } },
                  "required": ["kind", "value"]
                }
              },
              "required": ["provider", "repository", "path", "revision"]
            },
            "resolvedCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "blobId": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "policyId": { "type": "string" },
            "helper": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": { "const": "github-policy-reader" },
                "package": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": { "name": { "type": "string" }, "version": { "type": "string" } },
                  "required": ["name", "version"]
                }
              },
              "required": ["id", "package"]
            }
          },
          "required": ["source", "resolvedCommit", "blobId", "contentDigest", "policyId", "helper"]
        },
        "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "helperSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "candidateKind": { "enum": ["system-ca", "extra-ca"] },
        "certificates": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ]
        }
      },
      "required": ["package"],
      "allOf": [{
        "if": { "properties": { "candidateKind": { "const": "system-ca" } }, "required": ["candidateKind"] },
        "then": { "properties": { "certificates": { "type": "array", "maxItems": 0 } } },
        "else": { "properties": { "certificates": { "type": "array", "minItems": 1 } } }
      }],
      "oneOf": [
        { "properties": { "policySha256": {} }, "required": ["policySha256"] },
        { "properties": { "sourceSha256": {}, "helperSha256": {}, "certificates": {} },
          "required": ["sourceSha256", "helperSha256", "certificates"] }
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "file.write",
              "config.entries",
              "text.block",
              "file.remove",
              "process.run"
            ]
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "effects": {
            "enum": [
              "create-file",
              "replace-file",
              "remove-file",
              "already-satisfied",
              "conflict",
              "opaque-process",
              "unavailable"
            ]
          },
          "ownership": {
            "enum": [
              "managed",
              "unowned"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "details": {
                  "$ref": "#/$defs/reviewDetails"
                },
                "kind": {
                  "enum": [
                    "file.sha256",
                    "process.exit"
                  ]
                }
              },
              "required": [
                "id",
                "purpose",
                "kind",
                "details"
              ]
            }
          },
          "details": {
            "$ref": "#/$defs/reviewDetails"
          }
        },
        "required": [
          "id",
          "purpose",
          "kind",
          "scope",
          "effects",
          "ownership",
          "requires",
          "checks",
          "details"
        ]
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "reason"
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "encountered": {
            "type": "string"
          },
          "supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "reason",
          "message"
        ]
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "encountered": {
            "type": "string"
          },
          "supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "reason",
          "message"
        ]
      }
    },
    "effectiveOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "enum": [
                "on",
                "off"
              ]
            },
            "origin": {
              "enum": [
                "default",
                "explicit"
              ]
            }
          },
          "required": [
            "value",
            "origin"
          ]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "origin": {
                "enum": [
                  "default",
                  "explicit",
                  "private"
                ]
              }
            },
            "required": [
              "origin"
            ]
          }
        }
      },
      "required": [
        "logging",
        "inputs"
      ]
    },
    "reviewDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "enterprise" } }, "required": ["mode"] },
      "then": { "properties": { "inputs": { "type": "object", "properties": { "policySha256": {}, "organization": {} }, "required": ["policySha256", "organization"] } } },
      "else": { "properties": { "inputs": { "type": "object", "not": { "properties": { "organization": {} }, "required": ["organization"] } } } }
    }
  ],
  "$defs": {
    "effectiveInteger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "origin"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "enum": [
            "default",
            "explicit"
          ]
        }
      }
    },
    "reviewDetails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "executable": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "stdinProtected": {
          "type": "boolean"
        },
        "material": {
          "type": "string"
        },
        "timeoutMs": {
          "$ref": "#/$defs/effectiveInteger"
        },
        "maxOutputBytes": {
          "$ref": "#/$defs/effectiveInteger"
        },
        "declaredEffects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "materialSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "materialBytes": {
          "type": "integer",
          "minimum": 0
        },
        "executableSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "acceptedExitCodes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "format": {
          "enum": [
            "json",
            "jsonc",
            "toml"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string"
              },
              "action": {
                "enum": [
                  "set",
                  "remove"
                ]
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "path",
              "action"
            ]
          }
        },
        "blockId": {
          "type": "string"
        },
        "startMarker": {
          "type": "string"
        },
        "endMarker": {
          "type": "string"
        },
        "blockAction": {
          "enum": [
            "set",
            "remove"
          ]
        },
        "stdin": {
          "type": "string"
        }
      },
      "required": []
    }
  },
  "required": [
    "schema",
    "useCase",
    "mode",
    "target",
    "inputs",
    "operations",
    "observations",
    "conflicts",
    "omissions",
    "effectiveOptions",
    "reviewDigest"
  ]
}
