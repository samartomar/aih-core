{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:harness:native-test-identity:1.0.0",
  "title": "Harness native test identity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "client", "adapterId", "purpose", "expected", "credential"],
  "properties": {
    "schema": { "const": "urn:aihq:harness:native-test-identity:1.0.0" },
    "id": { "$ref": "#/$defs/nativeId" },
    "client": { "const": "claude" },
    "adapterId": { "const": "claude-oauth-otel.v1" },
    "purpose": { "const": "dedicated-native-test" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountUuid", "organizationId"],
      "properties": {
        "accountUuid": { "$ref": "#/$defs/uuid" },
        "organizationId": { "$ref": "#/$defs/uuid" }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byteLength"],
      "properties": {
        "path": { "const": "oauth.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 65536 }
      }
    }
  },
  "$defs": {
    "nativeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
  }
}
