{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:harness:diagnostic:1.0.0",
  "$comment": "Published copy with attribution. Source: @aihq/core Harness diagnostic schema `urn:aihq:harness:diagnostic:1.0.0` (Apache-2.0). Core reporting copies this schema as a data artifact and does not import producer internals at runtime. The copy is byte-faithful apart from this comment.",
  "title": "Harness diagnostic result",
  "description": "The existing diagnose result. Callers select this schema externally through contractSupport; results do not contain a schema discriminator. This schema checks structure, not whether a diagnostic passed or a repair was authorized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "helper",
    "status",
    "tools",
    "observations",
    "checks",
    "diagnostics",
    "repairChoices",
    "limits"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "helper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "completed",
        "invalid",
        "unavailable",
        "cancelled"
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "state",
          "selection"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "state": {
            "enum": [
              "binary",
              "runnable",
              "broken",
              "config-only",
              "absent"
            ]
          },
          "selection": {
            "enum": [
              "requested",
              "detected",
              "unselected"
            ]
          },
          "config": {
            "type": "string"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "outcome",
          "reason",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "unavailable",
              "skipped"
            ]
          },
          "reason": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "reason",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "repairChoices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "kind",
          "reason",
          "guidance"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "kind": {
            "const": "manual-guidance"
          },
          "reason": {
            "type": "string"
          },
          "guidance": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budgetMs",
        "elapsedMs",
        "maxActiveProbes"
      ],
      "properties": {
        "budgetMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180000
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "maxActiveProbes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      }
    }
  }
}
